import resources;
import telnyx;

#include <stdio.h>
#include <string.h>
#include <yyjson.h>

int main(void) {
    resources::set desired;
    yyjson_doc *manifest_document;
    int success;

    manifest_document = yyjson_read(
        "{\"messaging_profiles\":{\"main\":{\"name\":\"main\"}},"
        "\"outbound_voice_profiles\":{\"main\":{\"name\":\"main\"}},"
        "\"credential_connections\":{\"main\":{\"connection_name\":\"main\"}},"
        "\"phone_numbers\":[{\"phone_number\":\"+12025550123\",\"voice\":{\"connection_id\":\"${telnyx.credential_connections.main.id}\"}}],"
        "\"messaging_phone_numbers\":[{\"phone_number\":\"+12025550123\",\"messaging_profile_id\":\"${telnyx.messaging_profiles.main.id}\"}]}",
        strlen(
            "{\"messaging_profiles\":{\"main\":{\"name\":\"main\"}},"
            "\"outbound_voice_profiles\":{\"main\":{\"name\":\"main\"}},"
            "\"credential_connections\":{\"main\":{\"connection_name\":\"main\"}},"
            "\"phone_numbers\":[{\"phone_number\":\"+12025550123\",\"voice\":{\"connection_id\":\"${telnyx.credential_connections.main.id}\"}}],"
            "\"messaging_phone_numbers\":[{\"phone_number\":\"+12025550123\",\"messaging_profile_id\":\"${telnyx.messaging_profiles.main.id}\"}]}"),
        0);
    resources::init(&desired);
    success = manifest_document && telnyx::add_declared(&desired, yyjson_doc_get_root(manifest_document)) && desired.count == 6 &&
              strcmp(desired.items[0].path, "telnyx/messaging_profiles/main") == 0 &&
              strcmp(desired.items[1].path, "telnyx/outbound_voice_profiles/main") == 0 &&
              strcmp(desired.items[2].path, "telnyx/credential_connections/main") == 0 &&
              strcmp(desired.items[3].path, "telnyx/phone_numbers/+12025550123") == 0 &&
              strcmp(desired.items[4].path, "telnyx/phone_numbers/+12025550123/voice") == 0 &&
              strcmp(desired.items[5].path, "telnyx/messaging_phone_numbers/+12025550123") == 0 &&
              !yyjson_obj_get(desired.items[3].json, "voice");
    resources::release(&desired);
    yyjson_doc_free(manifest_document);
    if (!success) {
        return 1;
    }
    puts("Telnyx native resources reconstruct independently");
    return 0;
}

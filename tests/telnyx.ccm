sh tools/build-lib.sh || error "could not build Functional Configurator library"
mkdir -p build || error "could not create build directory"
clang \
    -fprebuilt-module-path=build \
    -std=c++20 \
    -g \
    -Os \
    -x c++ \
    -c "$0" \
    -o build/telnyx-test.o || error "could not build Telnyx test"
clang \
    -fprebuilt-module-path=build \
    -std=c++20 \
    -g \
    -Os \
    build/telnyx-test.o \
    build/telnyx.o \
    build/http.o \
    build/resources.o \

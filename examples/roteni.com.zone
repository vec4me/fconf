; managed by Functional Configurator
$INCLUDE _defaults.zone
; cloudflare page-domain roteni-website:roteni.com
; cloudflare page-domain roteni-website:www.roteni.com
; cloudflare redirect 301 '(http.host eq "roteni.com")' 'concat("https://www.roteni.com", http.request.uri.path)'
; cloudflare redirect 301 '(http.host eq "www.roteni.com" and starts_with(http.request.uri.path, "/fbclid"))' 'concat("https://www.roteni.com/", "")'
; cloudflare route api.roteni.com/*=roteni-api
; cloudflare email-forward *=vec4me@icloud.com
roteni.com.        1 IN CNAME roteni.pages.dev.              ; cloudflare proxied
www.roteni.com.    1 IN CNAME roteni.pages.dev.              ; cloudflare proxied
api.roteni.com.    1 IN CNAME roteni-api.vec4me.workers.dev. ; cloudflare proxied
_dmarc.roteni.com. 1 IN TXT   "v=DMARC1; p=quarantine;"

{
  "zones": {
      "campaign.example": {
        "rulesets": {
          "phases": {
            "http_request_dynamic_redirect": {
              "rules": [
                {
                  "expression": "(http.host eq \"campaign.example\")",
                  "action": "redirect",
                  "action_parameters": { "from_value": { "target_url": { "value": "https://example.com" }, "status_code": 301, "preserve_query_string": true } },
                  "enabled": true
                }
              ]
            }
          }
        }
      }
  }
}

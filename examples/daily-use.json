{
  "zones": {
      "example.net": {
        "settings": { "ssl": { "value": "full" } },
        "dns_records": {
          "root": { "type": "A", "name": "example.net", "content": "203.0.113.10", "proxied": true, "ttl": 1 },
          "calendar": { "type": "CNAME", "name": "calendar.example.net", "content": "calendar-host.example.net", "proxied": false, "ttl": 1 }
        },
        "email_routing": {
          "rules": {
            "catch_all": {
              "enabled": true,
              "actions": [{ "type": "forward", "value": ["me@example.net"] }],
              "matchers": [{ "type": "all" }]
            }
          }
        }
      }
  }
}
